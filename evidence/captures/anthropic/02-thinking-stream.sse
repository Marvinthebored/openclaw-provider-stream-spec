data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"# Finding the Greatest Common Divisor of 84 and 30\n\n## Using the Euclidean Algorithm\n\n**Step 1:** Divide 84"}  }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" by 30\n$$84 = 2 \\times 30 + 24$$\nThe remainder is **24**\n\n**Step 2:** Divide 30 by 24\n$$"}    }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"30 = 1 \\times 24 + 6$$\nThe remainder is **6**\n\n**Step 3:** Divide 24 by 6\n$$24 = 4 \\times 6 + 0$$\nThe remainder is **0**"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" → we stop here!\n\n## Verification\n- Factors"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" of 84: 1, 2, 3, 4, **6**, 7, 12, 14, 21, 28, 42, 84\n- Factors of 30: 1, 2, 3, "}     }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"5, **6**, 10, 15, 30\n\n## Answer\n$$\\gcd(84, 30) = \\boxed{6}$$"}               }

